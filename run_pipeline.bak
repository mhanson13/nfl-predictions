@echo off
setlocal enabledelayedexpansion

rem Default flags
set DEBUG_FLAG=
set START_YEAR=2023

:parse_args
if "%~1"=="" goto args_done
if /I "%~1"=="--debug" (
    set DEBUG_FLAG=--debug
    shift
    goto parse_args
)
if /I "%~1"=="--debug=true" (
    set DEBUG_FLAG=--debug
    shift
    goto parse_args
)
if /I "%~1"=="--start_year" (
    shift
    if "%~1"=="" (
        echo Missing value for --start_year
        exit /b 1
    )
    set START_YEAR=%~1
    shift
    goto parse_args
)
echo Unknown argument: %~1
exit /b 1

:args_done

for /f %%Y in ('powershell -NoProfile -Command "(Get-Date).Year"') do set CURRENT_YEAR=%%Y

set YEARS=
for /L %%Y in (%START_YEAR%,1,%CURRENT_YEAR%) do (
    if defined YEARS (
        set YEARS=!YEARS! %%Y
    ) else (
        set YEARS=%%Y
    )
)

if not defined YEARS (
    echo Failed to build year list. Check --start_year value.
    exit /b 1
) else (
    echo Years to process: !YEARS!
)


set "PRED_DIR=predictions"
if not exist "!PRED_DIR!" (
    mkdir "!PRED_DIR!"
)
set "PRED_SAVE=!PRED_DIR!\predictions.csv"
set "PRED_FULL_SAVE=!PRED_DIR!\predictions_full.csv"
set "PRED_QB_SAVE=!PRED_DIR!\predictions_players_qb.csv"
set "PRED_OFF_SAVE=!PRED_DIR!\predictions_players_offense.csv"
set "PRED_DEF_SAVE=!PRED_DIR!\predictions_players_defense.csv"

for %%F in (predictions*.csv) do (
    if exist "%%F" (
        call :MoveToPredDir "%%F"
    )
)
for %%F in (predictions*.csv.backup_*) do (
    if exist "%%F" (
        call :MoveToPredDir "%%F"
    )
)

rem python -m pip install -r requirements.txt
python -m src.data.nflverse --season !YEARS! --pbp --schedules --rosters --injuries --snaps --participation --depthcharts --players --pfr passing rushing receiving %DEBUG_FLAG%
python -m src.data.nflcom --year !YEARS! --category passing rushing receiving scoring downs %DEBUG_FLAG%
python -m src.data.espn_players --season !YEARS! --season_type 2 --category passing rushing receiving %DEBUG_FLAG%
python -m src.data.espn_player_news --season !CURRENT_YEAR! --limit 4 %DEBUG_FLAG%
python -m src.data.espn_team_news --season !CURRENT_YEAR! --limit 50 %DEBUG_FLAG%
python -m src.data.weather --season !YEARS! %DEBUG_FLAG%
python -m src.features.build_features --season !YEARS! %DEBUG_FLAG%
python -m src.models.train --target win_prob --calibrate %DEBUG_FLAG%
python -m src.models.train --target spread --calibrate %DEBUG_FLAG%
python -m src.predict.predict_upcoming --season !CURRENT_YEAR! --week auto --save "!PRED_SAVE!" --dump-all "!PRED_FULL_SAVE!" --save-players-qb "!PRED_QB_SAVE!" --save-players-offense "!PRED_OFF_SAVE!" --save-players-defense "!PRED_DEF_SAVE!" %DEBUG_FLAG%

goto :final_end

:MoveToPredDir
set "SRC=%~1"
if not defined SRC goto :eof
if not exist "%SRC%" goto :eof
set "NAME=%~n1"
set "EXT=%~x1"
set "TARGET=!PRED_DIR!\%~nx1"
if not exist "%TARGET%" (
    move "%SRC%" "!PRED_DIR!\" >nul
) else (
    set "COUNTER=1"
:move_retry
    set "CAND=!PRED_DIR!\%NAME%.migration_!COUNTER!%EXT%"
    if exist "!CAND!" (
        set /a COUNTER+=1
        goto :move_retry
    )
    move "%SRC%" "!CAND!" >nul
)
goto :eof

:final_end
endlocal
